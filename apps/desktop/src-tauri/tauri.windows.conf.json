{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "acta",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      },
      {
        "label": "overlay",
        "title": "acta",
        "url": "overlay.html",
        "width": 280,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$DATA/acta/**"
        ]
      }
    }
  },
  "bundle": {
    "targets": [
      "msi",
      "nsis"
    ]
  }
}
